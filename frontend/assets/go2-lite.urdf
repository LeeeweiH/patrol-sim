<?xml version="1.0"?>
<!--
  机器狗 go2-lite：简化版宇树 Go2 四足机器人 URDF
  =====================================================================
  用途：
    1) 作为页面里那只机器狗的「模型源」。frontend/assets/scene.svg 的
       关节层级（hip → thigh → knee → calf → foot）与本文件的关节名一一
       对应，页面上的关节角度和这里的 limit 是同一套约定。
    2) 以后想换成真正的三维渲染时，直接把这份文件丢给 three.js +
       urdf-loader（或 ROS / PyBullet / MuJoCo）就能动，不用重新建模。

  与真机的差异（有意简化，够用且好读）：
    - 尺寸按 Go2 公开参数取整：髋部横向偏置 0.0465 m、前后偏置
      0.1934 m、大腿 0.213 m、小腿 0.213 m、机身 0.31×0.19×0.10 m 左右。
    - 几何体用 box / cylinder 近似，不挂 STL/DAE 网格，省掉几十 MB 资源。
    - 惯性参数按实心长方体估算，只保证量级正确，不做动力学标定。
    - 没有足底传感器、IMU 和关节电机模型，只有运动学骨架。

  坐标约定：
    x 向前、y 向左、z 向上（URDF 常规右手系）。
    机身原点在几何中心，四条腿从髋部向下延伸。
-->
<robot name="go2_lite">

  <!-- ===================== 机身 ===================== -->
  <link name="base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.36 0.20 0.10"/>
      </geometry>
      <material name="shell">
        <color rgba="0.85 0.88 0.90 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.36 0.20 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="6.0"/>
      <inertia ixx="0.0300" ixy="0" ixz="0" iyy="0.0700" iyz="0" izz="0.0900"/>
    </inertial>
  </link>

  <!-- 头部：激光雷达 + 摄像头，固定件，只影响外观 -->
  <link name="head">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.14 0.07"/>
      </geometry>
      <material name="visor">
        <color rgba="0.13 0.18 0.22 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0004"/>
    </inertial>
  </link>
  <joint name="head_joint" type="fixed">
    <parent link="base"/>
    <child link="head"/>
    <origin xyz="0.21 0 0.03" rpy="0 0 0"/>
  </joint>

  <!-- 雷达（示意） -->
  <link name="lidar">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.03"/>
      </geometry>
      <material name="lidar_glass">
        <color rgba="0.10 0.14 0.18 0.9"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="head"/>
    <child link="lidar"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- ===================== 四条腿 =====================
       每条腿三个关节：
         *_hip_joint   横滚，绕 x 轴，决定腿外张/内收
         *_thigh_joint 俯仰，绕 y 轴，大腿前后摆
         *_calf_joint  俯仰，绕 y 轴，小腿（膝关节）弯曲，只能单向
       hip 原点相对 base：(±0.1934, ±0.0465, -0.02)
  -->

  <!-- ===== 左前 FL ===== -->
  <joint name="FL_hip_joint" type="revolute">
    <parent link="base"/>
    <child link="FL_hip"/>
    <origin xyz="0.1934 0.0465 -0.02" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.87" upper="0.87" effort="24" velocity="30"/>
  </joint>
  <link name="FL_hip">
    <visual>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.06"/>
      </geometry>
      <material name="joint_grey">
        <color rgba="0.35 0.40 0.45 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0004"/>
    </inertial>
  </link>

  <joint name="FL_thigh_joint" type="revolute">
    <parent link="FL_hip"/>
    <child link="FL_thigh"/>
    <origin xyz="0 0 -0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="3.3" effort="24" velocity="30"/>
  </joint>
  <link name="FL_thigh">
    <visual>
      <origin xyz="0 0 -0.1065" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.05 0.213"/>
      </geometry>
      <material name="shell">
        <color rgba="0.85 0.88 0.90 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 -0.1065" rpy="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.0028" ixy="0" ixz="0" iyy="0.0028" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="FL_calf_joint" type="revolute">
    <parent link="FL_thigh"/>
    <child link="FL_calf"/>
    <origin xyz="0 0 -0.213" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.70" upper="-0.10" effort="36" velocity="30"/>
  </joint>
  <link name="FL_calf">
    <visual>
      <origin xyz="0 0 -0.1065" rpy="0 0 0"/>
      <geometry>
        <box size="0.045 0.04 0.213"/>
      </geometry>
      <material name="shell">
        <color rgba="0.80 0.84 0.87 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 -0.1065" rpy="0 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="0.0013" ixy="0" ixz="0" iyy="0.0013" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="FL_foot_joint" type="fixed">
    <parent link="FL_calf"/>
    <child link="FL_foot"/>
    <origin xyz="0 0 -0.213" rpy="0 0 0"/>
  </joint>
  <link name="FL_foot">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.022"/>
      </geometry>
      <material name="foot_rubber">
        <color rgba="0.12 0.14 0.16 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <!-- ===== 右前 FR ===== -->
  <joint name="FR_hip_joint" type="revolute">
    <parent link="base"/>
    <child link="FR_hip"/>
    <origin xyz="0.1934 -0.0465 -0.02" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.87" upper="0.87" effort="24" velocity="30"/>
  </joint>
  <link name="FR_hip">
    <visual>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.06"/>
      </geometry>
      <material name="joint_grey">
        <color rgba="0.35 0.40 0.45 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0004"/>
    </inertial>
  </link>

  <joint name="FR_thigh_joint" type="revolute">
    <parent link="FR_hip"/>
    <child link="FR_thigh"/>
    <origin xyz="0 0 -0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="3.3" effort="24" velocity="30"/>
  </joint>
  <link name="FR_thigh">
    <visual>
      <origin xyz="0 0 -0.1065" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.05 0.213"/>
      </geometry>
      <material name="shell">
        <color rgba="0.85 0.88 0.90 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 -0.1065" rpy="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.0028" ixy="0" ixz="0" iyy="0.0028" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="FR_calf_joint" type="revolute">
    <parent link="FR_thigh"/>
    <child link="FR_calf"/>
    <origin xyz="0 0 -0.213" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.70" upper="-0.10" effort="36" velocity="30"/>
  </joint>
  <link name="FR_calf">
    <visual>
      <origin xyz="0 0 -0.1065" rpy="0 0 0"/>
      <geometry>
        <box size="0.045 0.04 0.213"/>
      </geometry>
      <material name="shell">
        <color rgba="0.80 0.84 0.87 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 -0.1065" rpy="0 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="0.0013" ixy="0" ixz="0" iyy="0.0013" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="FR_foot_joint" type="fixed">
    <parent link="FR_calf"/>
    <child link="FR_foot"/>
    <origin xyz="0 0 -0.213" rpy="0 0 0"/>
  </joint>
  <link name="FR_foot">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.022"/>
      </geometry>
      <material name="foot_rubber">
        <color rgba="0.12 0.14 0.16 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <!-- ===== 左后 RL ===== -->
  <joint name="RL_hip_joint" type="revolute">
    <parent link="base"/>
    <child link="RL_hip"/>
    <origin xyz="-0.1934 0.0465 -0.02" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.87" upper="0.87" effort="24" velocity="30"/>
  </joint>
  <link name="RL_hip">
    <visual>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.06"/>
      </geometry>
      <material name="joint_grey">
        <color rgba="0.35 0.40 0.45 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0004"/>
    </inertial>
  </link>

  <joint name="RL_thigh_joint" type="revolute">
    <parent link="RL_hip"/>
    <child link="RL_thigh"/>
    <origin xyz="0 0 -0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="3.3" effort="24" velocity="30"/>
  </joint>
  <link name="RL_thigh">
    <visual>
      <origin xyz="0 0 -0.1065" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.05 0.213"/>
      </geometry>
      <material name="shell">
        <color rgba="0.85 0.88 0.90 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 -0.1065" rpy="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.0028" ixy="0" ixz="0" iyy="0.0028" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="RL_calf_joint" type="revolute">
    <parent link="RL_thigh"/>
    <child link="RL_calf"/>
    <origin xyz="0 0 -0.213" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.70" upper="-0.10" effort="36" velocity="30"/>
  </joint>
  <link name="RL_calf">
    <visual>
      <origin xyz="0 0 -0.1065" rpy="0 0 0"/>
      <geometry>
        <box size="0.045 0.04 0.213"/>
      </geometry>
      <material name="shell">
        <color rgba="0.80 0.84 0.87 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 -0.1065" rpy="0 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="0.0013" ixy="0" ixz="0" iyy="0.0013" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="RL_foot_joint" type="fixed">
    <parent link="RL_calf"/>
    <child link="RL_foot"/>
    <origin xyz="0 0 -0.213" rpy="0 0 0"/>
  </joint>
  <link name="RL_foot">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.022"/>
      </geometry>
      <material name="foot_rubber">
        <color rgba="0.12 0.14 0.16 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <!-- ===== 右后 RR ===== -->
  <joint name="RR_hip_joint" type="revolute">
    <parent link="base"/>
    <child link="RR_hip"/>
    <origin xyz="-0.1934 -0.0465 -0.02" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.87" upper="0.87" effort="24" velocity="30"/>
  </joint>
  <link name="RR_hip">
    <visual>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.06"/>
      </geometry>
      <material name="joint_grey">
        <color rgba="0.35 0.40 0.45 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0004"/>
    </inertial>
  </link>

  <joint name="RR_thigh_joint" type="revolute">
    <parent link="RR_hip"/>
    <child link="RR_thigh"/>
    <origin xyz="0 0 -0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="3.3" effort="24" velocity="30"/>
  </joint>
  <link name="RR_thigh">
    <visual>
      <origin xyz="0 0 -0.1065" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.05 0.213"/>
      </geometry>
      <material name="shell">
        <color rgba="0.85 0.88 0.90 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 -0.1065" rpy="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.0028" ixy="0" ixz="0" iyy="0.0028" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="RR_calf_joint" type="revolute">
    <parent link="RR_thigh"/>
    <child link="RR_calf"/>
    <origin xyz="0 0 -0.213" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.70" upper="-0.10" effort="36" velocity="30"/>
  </joint>
  <link name="RR_calf">
    <visual>
      <origin xyz="0 0 -0.1065" rpy="0 0 0"/>
      <geometry>
        <box size="0.045 0.04 0.213"/>
      </geometry>
      <material name="shell">
        <color rgba="0.80 0.84 0.87 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 -0.1065" rpy="0 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="0.0013" ixy="0" ixz="0" iyy="0.0013" iyz="0" izz="0.0001"/>
